# Configuración de la aplicación de Gestión Documental
# Variables de entorno para desarrollo (prefijo NUXT_ requerido por Nuxt 4)

# Backend real al que Nitro reenvía /api en desarrollo (solo servidor)
NUXT_API_BACKEND_URL=http://10.15.13.37:9099/api

# Base URL que usa el cliente para llamar a la API (ruta relativa → pasa por devProxy)
NUXT_PUBLIC_API_BASE=/api

# Configuración OAuth 2.0
NUXT_PUBLIC_OAUTH_CLIENT_ID=your_oauth_client_id
NUXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
NUXT_PUBLIC_OAUTH_BASE_URL=http://10.15.13.37:9011/api/o
NUXT_PUBLIC_OAUTH_AUTH_URL=http://10.15.13.37:9011/api/o/authorize/
NUXT_PUBLIC_OAUTH_TOKEN_URL=http://10.15.13.37:9011/api/o/token/
NUXT_PUBLIC_OAUTH_REVOKE_URL=http://10.15.13.37:9011/api/o/revoke_token/
NUXT_PUBLIC_OAUTH_SCOPE=api openid introspection

# Configuración de la aplicación
NUXT_PUBLIC_APP_NAME=Gestion Documental | SABG
NUXT_PUBLIC_APP_VERSION=1.0.0
NUXT_PUBLIC_APP_ENVIRONMENT=development

# Configuración de desarrollo
NUXT_PUBLIC_DEBUG_MODE=true
NUXT_PUBLIC_LOG_LEVEL=info
NUXT_PUBLIC_USE_MOCK=true
