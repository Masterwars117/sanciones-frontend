{
  "name": "gestiondocumental-frontend-dev",
  "dockerComposeFile": ["../docker/dev/docker-compose.yml", "docker-compose.yml"],
  "service": "nuxt",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "node",
  "overrideCommand": false,
  "forwardPorts": [3000],
  "postCreateCommand": "npm ci || npm install",
  "postStartCommand": "npm run dev -- --host 0.0.0.0 --port 3000",
  "postAttachCommand": "sudo ln -sf /vscode/vscode-server/bin/linux-alpine/*/bin/remote-cli/code /usr/local/bin/code 2>/dev/null || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "Nuxtr.nuxt-vscode-extentions",
        "esbenp.prettier-vscode",
        "christian-kohler.path-intellisense",
        "PKief.material-icon-theme",
        "GitHub.copilot-chat",
        "GitHub.copilot",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-containers",
        "christian-kohler.npm-intellisense"
      ]
    }
  }
}
